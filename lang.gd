	"shop_non_pronto": {"it": "Negozio in collegamento, riprova tra poco", "en": "Shop is connecting, try again shortly", "es": "Conectando la tienda, inténtalo en un momento", "de": "Shop verbindet sich, versuche es gleich nochmal", "fr": "Connexion à la boutique, réessaie dans un instant", "pt": "A ligar à loja, tenta daqui a pouco", "ru": "Подключение к магазину, попробуй чуть позже"},
	"shop_attendi": {"it": "Attendi…", "en": "Please wait…", "es": "Espera…", "de": "Bitte warten…", "fr": "Patiente…", "pt": "Aguarda…", "ru": "Подожди…"},
	"shop_ok": {"it": "Acquisto riuscito, monete aggiunte!", "en": "Purchase complete, coins added!", "es": "¡Compra completada, monedas añadidas!", "de": "Kauf erfolgreich, Münzen gutgeschrieben!", "fr": "Achat réussi, pièces ajoutées !", "pt": "Compra concluída, moedas adicionadas!", "ru": "Покупка успешна, монеты зачислены!"},
