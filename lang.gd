	"shop_nota": {"it": "Monete virtuali per giocare: non hanno valore reale e non si possono riscuotere.", "en": "Virtual coins for play only: they have no real value and cannot be cashed out.", "es": "Monedas virtuales solo para jugar: no tienen valor real y no se pueden canjear.", "de": "Virtuelle Spielmünzen: Sie haben keinen echten Wert und können nicht ausgezahlt werden.", "fr": "Pièces virtuelles pour jouer : elles n'ont aucune valeur réelle et ne peuvent pas être encaissées.", "pt": "Moedas virtuais só para jogar: não têm valor real e não podem ser resgatadas.", "ru": "Виртуальные монеты только для игры: они не имеют реальной ценности и не обмениваются на деньги."},
	"shop_prova": {"it": "MODALITÀ PROVA: nessun pagamento", "en": "TEST MODE: no payment", "es": "MODO PRUEBA: sin pago", "de": "TESTMODUS: keine Zahlung", "fr": "MODE TEST : aucun paiement", "pt": "MODO TESTE: sem pagamento", "ru": "ТЕСТОВЫЙ РЕЖИМ: без оплаты"},
