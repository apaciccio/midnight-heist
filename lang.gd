	"shop_errore": {"it": "Acquisto non riuscito, riprova", "en": "Purchase failed, try again", "es": "La compra falló, inténtalo de nuevo", "de": "Kauf fehlgeschlagen, versuche es erneut", "fr": "L'achat a échoué, réessaie", "pt": "A compra falhou, tenta de novo", "ru": "Покупка не удалась, попробуй снова"},
	"shop_attesa": {"it": "Pagamento in attesa: le monete arriveranno appena confermato", "en": "Payment pending: coins will arrive once it is confirmed", "es": "Pago pendiente: las monedas llegarán al confirmarse", "de": "Zahlung ausstehend: Münzen kommen nach der Bestätigung", "fr": "Paiement en attente : les pièces arriveront après confirmation", "pt": "Pagamento pendente: as moedas chegam quando for confirmado", "ru": "Платёж в обработке: монеты придут после подтверждения"},
